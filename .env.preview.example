# Preview is PR-scoped, sanitized, and never inherits generic or production
# credentials. The provider double is the default until preview credentials
# are intentionally approved and stored under the preview namespace.
APP_ENV=preview
VERCEL_ENV=preview
WAYFINDER_PREVIEW_AUTH_MODE=provider-double
WAYFINDER_PREVIEW_DATA_MODE=provider-double
WAYFINDER_PREVIEW_TELEMETRY_MODE=disabled
WAYFINDER_PREVIEW_AUTH_PROVIDER=double
WAYFINDER_PREVIEW_AUTH0_SECRET=<preview-only-session-secret>
WAYFINDER_PREVIEW_DATABASE_URL=
WAYFINDER_PREVIEW_NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
WAYFINDER_PREVIEW_NEXT_PUBLIC_POSTHOG_KEY=
