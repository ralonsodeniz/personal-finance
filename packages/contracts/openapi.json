{
  "openapi": "3.1.0",
  "info": {
    "title": "Wayfinder system API",
    "version": "0.1.0",
    "description": "The first non-financial, versioned API boundary for Wayfinder."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/system/health": {
      "get": {
        "operationId": "getSystemHealth",
        "summary": "Read system health",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["system"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The system and migration boundary is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemHealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request query does not match the contract.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "405": {
            "description": "The HTTP method is not supported.",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string",
                  "const": "GET"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Read the versioned system API description",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemHealthData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["database", "migrations", "provider"],
        "properties": {
          "database": {
            "type": "string",
            "enum": ["ready", "unavailable"]
          },
          "migrations": {
            "type": "string",
            "enum": ["ready", "pending", "unavailable"]
          },
          "provider": {
            "type": "string",
            "enum": ["postgresql", "provider-double"]
          }
        }
      },
      "SystemHealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkedAt", "contractVersion", "data", "service", "status"],
        "properties": {
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "contractVersion": {
            "type": "string",
            "const": "v1"
          },
          "data": {
            "$ref": "#/components/schemas/SystemHealthData"
          },
          "service": {
            "type": "string",
            "const": "wayfinder"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          }
        }
      },
      "ProblemDetailsError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "path"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detail", "status", "title", "type"],
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemDetailsError"
            }
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
