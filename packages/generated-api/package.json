{
  "name": "@personal-finance/generated-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-generated": "node scripts/generate.mjs --check",
    "placeholder": "node ../../scripts/workspace-placeholder.mjs generated-api",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "node ../../scripts/workspace-lint.mjs",
    "format:check": "prettier --check .",
    "test": "pnpm run check-generated && vitest run --config ../../vitest.config.mjs --passWithNoTests"
  },
  "devDependencies": {
    "@personal-finance/config-eslint": "workspace:*",
    "@personal-finance/config-prettier": "workspace:*",
    "@personal-finance/config-typescript": "workspace:*",
    "@personal-finance/config-vitest": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  }
}
