# Production is protected, reviewer-approved, and uses separately scoped
# provider values. This template intentionally contains names only.
APP_ENV=production
VERCEL_ENV=production
WAYFINDER_PRODUCTION_AUTH_MODE=provider
WAYFINDER_PRODUCTION_DATA_MODE=postgresql
WAYFINDER_PRODUCTION_TELEMETRY_MODE=configured
WAYFINDER_PRODUCTION_AUTH_PROVIDER=auth0
WAYFINDER_PRODUCTION_AUTH0_DOMAIN=
WAYFINDER_PRODUCTION_AUTH0_CLIENT_ID=
WAYFINDER_PRODUCTION_AUTH0_CLIENT_SECRET=
WAYFINDER_PRODUCTION_AUTH0_SECRET=
WAYFINDER_PRODUCTION_DATABASE_URL=
WAYFINDER_PRODUCTION_NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
WAYFINDER_PRODUCTION_NEXT_PUBLIC_POSTHOG_KEY=
