# Copy this file to .env.local and fill in values only on your machine.
# Never commit .env.local, production secrets, provider API keys, or real user data.
# These names are the development defaults. Preview and production use the
# explicit WAYFINDER_<ENVIRONMENT>_* names in their environment templates.

# Logical application environment. Next.js may still set NODE_ENV=production
# for a preview build; APP_ENV is the deployment boundary used by the app.
APP_ENV=development
VERCEL_ENV=development
WAYFINDER_AUTH_MODE=auth0
WAYFINDER_DATA_MODE=provider-double
WAYFINDER_TELEMETRY_MODE=disabled

# Shared local URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
EXPO_SCHEME=personalfinance
EXPO_IOS_BUNDLE_ID=com.personalfinance.app
EXPO_ANDROID_PACKAGE=com.personalfinance.app

# Optional product analytics. The adapter accepts only this EU PostHog boundary
# and keeps replay disabled. Leave the public project key blank for provider-free
# local verification; never put a secret or real user data here.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only PostgreSQL connection. Leave blank to use the provider-free
# Drizzle connection double used by local verification.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth0 (web Regular Web Application + future Expo Native Application)
# -----------------------------------------------------------------------------
# Auth0 Next.js v4 expects the tenant host, for example dev-abc123.us.auth0.com
# Native values remain blank until the Expo implementation begins.
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_NATIVE_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email offline_access
AUTH0_SECRET=
AUTH0_NATIVE_DOMAIN=
AUTH0_WEB_CALLBACK_URL=http://localhost:3000/auth/callback
AUTH0_WEB_LOGOUT_URL=http://localhost:3000
AUTH0_WEB_ALLOWED_ORIGIN=http://localhost:3000
AUTH0_NATIVE_CALLBACK_URL_IOS=
AUTH0_NATIVE_CALLBACK_URL_ANDROID=
