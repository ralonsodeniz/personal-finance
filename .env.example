# Copy this file to .env.local and fill in values only on your machine.
# Never commit .env.local, production secrets, provider API keys, or real user data.
# The application does not exist yet; these names are the proposed inputs for issue #16.

# Shared local URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
EXPO_SCHEME=personalfinance
EXPO_IOS_BUNDLE_ID=com.personalfinance.app
EXPO_ANDROID_PACKAGE=com.personalfinance.app

# -----------------------------------------------------------------------------
# Auth0 (web Regular Web Application + future Expo Native Application)
# -----------------------------------------------------------------------------
# Auth0 Next.js v4 expects the tenant host, for example dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_NATIVE_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email offline_access
AUTH0_SECRET=
AUTH0_NATIVE_DOMAIN=
AUTH0_WEB_CALLBACK_URL=http://localhost:3000/auth/callback
AUTH0_WEB_LOGOUT_URL=http://localhost:3000
AUTH0_WEB_ALLOWED_ORIGIN=http://localhost:3000
AUTH0_NATIVE_CALLBACK_URL_IOS=
AUTH0_NATIVE_CALLBACK_URL_ANDROID=

# -----------------------------------------------------------------------------
# Clerk (development instance; publishable key may be exposed to clients)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_URL=

# -----------------------------------------------------------------------------
# WorkOS AuthKit (staging environment; server-side values stay private)
# -----------------------------------------------------------------------------
WORKOS_CLIENT_ID=
WORKOS_MOBILE_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_WEB_LOGOUT_URI=http://localhost:3000
WORKOS_MOBILE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Test-only identifiers and notes (never real financial data)
# -----------------------------------------------------------------------------
AUTH_SPIKE_OWNER_EMAIL=
AUTH_SPIKE_ADVISOR_EMAIL=
AUTH_SPIKE_TEST_ORGANIZATION_ID=
